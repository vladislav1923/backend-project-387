{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["cursor-opencode-provider"],
  "plugins": ["cursor-opencode-provider/plugin/v2"],
  "provider": {
    "cursor": {
      "npm": "cursor-opencode-provider",
      "name": "Cursor",
      "options": {
        "apiKey": "{env:CURSOR_API_KEY}"
      },
      "models": {
        "composer-2.5": {
          "name": "Composer 2.5"
        },
        "default": {
          "name": "Auto"
        }
      }
    }
  },
  "model": "cursor/composer-2.5"
}
